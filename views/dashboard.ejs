<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>r00ts Database</title>
  <link rel="stylesheet" href="<%= root %>/style.css">

  <!-- Bootstrap 5 -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <!-- Date picker -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/vanillajs-datepicker@1.3.4/dist/css/datepicker-bs5.min.css">
  <script src="https://cdn.jsdelivr.net/npm/vanillajs-datepicker@1.3.4/dist/js/datepicker.min.js"></script>
</head>

<body class="bg-light">

  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="<%= root %>/dashboard">r00ts Database - Admin dashboard</a>
      <div class="text-end">
        <a href="<%= root %>/logout"><button class="btn btn-primary me-2">logout</button></a>
      </div>
    </div>
  </nav>

  <!-- Tools -->
  <div class="card m-4 p-3">
    <div>
      <button id="add-article-btn" class="btn btn-primary me-2" type="button" data-bs-toggle="modal" data-bs-target="#add-modal">Add article</button>
      <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseExample" aria-expanded="false" aria-controls="collapseExample">
        Search Filter...
      </button>
      <div class="collapse" id="collapseExample">
        <div class="card card-body m-4">
          <form id="search-form">
            <div class="card-body">
              <div class="form-check">
                <input class="form-check-input" type="radio" name="filter-approved" id="approved-all" checked>
                <label class="form-check-label" for="approved-all">All</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="filter-approved" id="approved-only">
                <label class="form-check-label" for="approved-only">Approved only</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="filter-approved" id="approved-none">
                <label class="form-check-label" for="approved-none">Un-approved only</label>
              </div>

              <div>
                <button id="search-btn" class="btn btn-primary me-2" type="button">Update search</button>
              </div>
            </div>
        </div>
        </form>
      </div>
    </div>
  </div>
  </div>

  <!-- List of Articles -->
  <div class="card m-4 p-3">
    <h4>Articles</h4>
    <table class="table">
      <thead id="result-headings">
        <tr>
          <th scope="col">id</th>
          <th scope="col-6">title</th>
          <th scope="col">type</th>
          <th scope="col">source</th>
          <th scope="col">date</th>
          <th scope="col">impacts</th>
          <th scope="col">communities</th>
          <th scope="col">location</th>
          <th scope="col">approved</th>
          <th scope="col" class="text-end">edit</th>
        </tr>
      </thead>
      <tbody id="result-table">

      </tbody>
    </table>
  </div>

  <!-- Message modal -->
  <div class="modal fade" id="message-modal" tabindex="-1" aria-labelledby="messageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">Error:</div>
        <div class="modal-body mb-3" id="message-body"></div>
        <div class="modal-footer">
          <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Add new article modal -->
  <div class="modal fade" id="add-modal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          Add article
        </div>
        <form id="add-article">
          <div class="modal-body mb-3">
            <input type="hidden" name="id" value="">

            <!-- Title -->
            <div class="input-group mb-3">
              <span class="input-group-text">Title</span>
              <input type="text" name="title" class="form-control" placeholder="Title" aria-label="Title" required>
            </div>

            <!-- URL -->
            <div class="input-group mb-3">
              <span class="input-group-text" for="url">URL</span>
              <input type="text" name="url" class="form-control" placeholder="URL" aria-label="URL" required>
            </div>

            <!-- Source -->
            <div class="input-group mb-3">
              <span class="input-group-text" for="article-source">Source</span>
              <select class="form-select" id="article-source" name="source">
                <option value="" selected>Choose...</option>
              </select>
              <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">new</button>
              <div class="dropdown-menu p-2">
                <div class="mb-3">
                  <input type="text" placeholder="Name" id="new-source-name">
                  <input type="text" placeholder="Homepage" id="new-source-url">
                  <button disabled class="btn btn-primary" id="new-source-submit">add</button>
                </div>
              </div>
            </div>

            <!-- Date -->
            <div class="input-group mb-3">
              <label class="input-group-text" for="article-date">Date</label>
              <input class="form-control" type="text" name="date" id="article-date">
            </div>

            <!-- Type -->
            <div class="input-group mb-3">
              <label class="input-group-text" for="article-type">Type</label>
              <select class="form-select" name="type" id="article-type">
                <option value="article" selected>Article</option>
                <option value="resource">Resource</option>
                <option value="press-release">Press release</option>
                <option value="meme">Meme</option>
              </select>
            </div>

            <!-- Impacts -->
            <div class="input-group mb-3">
              <label class="input-group-text">Impacts</label>
              <button class="btn btn-outline-secondary dropdown-toggle text-start" type="button" data-bs-toggle="dropdown" aria-expanded="false">None</button>
              <select class="dropdown-menu" name="impacts" multiple id="impact-select" aria-label="Impact multiselect menu">
              </select>
              <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">new</button>
              <div class="dropdown-menu p-2">
                <div class="mb-3">
                  <input type="text" placeholder="Name" id="new-impact-name">
                  <button class="btn btn-primary" id="new-impact-submit">add</button>
                </div>
              </div>
            </div>

            <!-- Communities -->
            <div class="input-group mb-3">
              <label class="input-group-text">Communities</label>
              <button class="btn btn-outline-secondary dropdown-toggle text-start" type="button" data-bs-toggle="dropdown" aria-expanded="false">None</button>
              <select class="dropdown-menu" name="communities" multiple id="communities-select" aria-label="Communities multiselect menu">
              </select>
              <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">new</button>
              <div class="dropdown-menu p-2">
                <div class="mb-3">
                  <input type="text" placeholder="Name" id="new-community-name">
                  <button class="btn btn-primary" id="new-community-submit">add</button>
                </div>
              </div>
            </div>

            <!-- Place -->
            <div class="input-group mb-3">
              <label class="input-group-text">Place</label>
              <select name="continent" class="form-select" aria-label="Continent select menu">
                <option value="">Worldwide</option>
              </select>
              <select name="country" disabled class="form-select" aria-label="Country select menu">
                <option value="">Country</option>
              </select>
              <select name="region" disabled class="form-select" aria-label="Region select menu">
                <option value="">Region</option>
              </select>
              <!-- <select name="city" disabled class="form-select" aria-label="City select menu">
                <option value="">City</option>
              </select> -->
            </div>

            <!-- Approved -->
            <input class="form-check-input" type="checkbox" id="approved" name="approved">
            <label class="form-check-label" for="approved">Approved</label>
          </div>

          <div class="modal-footer">
            <button type="button" id="delete-article" class="btn btn-danger invisible">Delete</button>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="button" id="send-article" class="btn btn-primary">Add</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    const ROOT = '<%= root %>';
  </script>
  <script src="<%= root %>/common.js"></script>
  <script src="<%= root %>/dashboard.js"></script>
  <script>
    window.fieldRender.approved = (item) => {
      return `<td class="text-center">${item.approved ? '<i class="bi bi-check-lg"></i>' : '<i class="bi bi-hourglass-split"></i>'}</td>`;
    }
    window.fieldRender.edit = (item) => {
      return `<td class="text-end"><i onclick="editArticle(${item.id})" data-bs-toggle="modal" data-bs-target="#add-modal" class="bi bi-pencil pointer"></i></td>`;
    }
  </script>

</body>

</html>