<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>r00ts Database</title>
  <link rel="stylesheet" href="<%= root %>/style.css">

  <!-- Bootstrap 5 -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p"
    crossorigin="anonymous"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <!-- Date picker -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/vanillajs-datepicker@1.3.4/dist/css/datepicker-bs5.min.css">
  <script src="https://cdn.jsdelivr.net/npm/vanillajs-datepicker@1.3.4/dist/js/datepicker.min.js"></script>
</head>

<body class="bg-light">

  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="<%= root %>/dashboard">r00ts Database - Admin dashboard</a>
      <div class="text-end">
        <a href="<%= root %>/logout"><button class="btn btn-primary me-2">logout</button></a>
      </div>
    </div>
  </nav>

  <!-- Tools -->
  <div class="card m-4 p-3">
    <div>
      <button id="add-article-btn" class="btn btn-primary me-2" type="button" data-bs-toggle="modal"
        data-bs-target="#add-modal">Add article</button>
      <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseExample"
        aria-expanded="false" aria-controls="collapseExample">
        Search Filter...
      </button>
        <%- include('partials/filter.ejs', {hasApproved: true}); %>
    </div>
  </div>

  <!-- List of Articles -->
  <div class="card m-4 p-3">
    <h4>Articles</h4>
    <table class="table">
      <thead id="result-headings">
        <tr>
          <th scope="col">id</th>
          <th scope="col-6">title</th>
          <th scope="col">type</th>
          <th scope="col">source</th>
          <th scope="col">date</th>
          <th scope="col">perspective</th>
          <th scope="col">companies</th>
          <th scope="col">impacts</th>
          <th scope="col">communities</th>
          <th scope="col">location</th>
          <th scope="col">approved</th>
          <th scope="col" class="text-end">edit</th>
        </tr>
      </thead>
      <tbody id="result-table">

      </tbody>
    </table>
  </div>

  <%- include('partials/message.ejs'); %>

  <!-- Add new article modal -->
  <%- include('partials/submission.ejs', {hasApproved: true}); %>

  <script>
    ROOT = '<%= root %>';
  </script>
  <script src="<%= root %>/common.js"></script>
  <script src="<%= root %>/dashboard.js"></script>
  <script>
    window.fieldRender.approved = (item) => {
      return `<td class="text-center">${item.approved ? '<i class="bi bi-check-lg"></i>' : '<i class="bi bi-hourglass-split"></i>'}</td>`;
    }
    window.fieldRender.edit = (item) => {
      return `<td class="text-end"><i onclick="editArticle(${item.id})" data-bs-toggle="modal" data-bs-target="#add-modal" class="bi bi-pencil pointer"></i></td>`;
    }
  </script>

</body>

</html>
