<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>r00ts Database</title>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body class="bg-light">

  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="<%= root %>/dashboard">r00ts Database</a>
      <div class="text-end">
        <a href="<%= root %>/login"><button class="btn btn-primary me-2">login</button></a>
      </div>
    </div>
  </nav>

  <!-- List of Articles -->
  <div class="card my-4 p-3">
    <h4>Articles</h4>
    <table class="table">
      <thead id="result-headings">
        <tr>
          <th scope="col">id</th>
          <th scope="col-6">title</th>
          <th scope="col">type</th>
          <th scope="col">source</th>
          <th scope="col">date</th>
          <th scope="col">impacts</th>
          <th scope="col">communities</th>
          <th scope="col">location</th>
        </tr>
      </thead>
      <tbody id="result-table">
      </tbody>
    </table>
  </div>

  <script>
    const ROOT = '<%= root %>';
  </script>
  <script src="<%= root %>/common.js"></script>

  <script>
    window.addEventListener('DOMContentLoaded', function() {
      fetchItems();
    });
  </script>
</body>

</html>